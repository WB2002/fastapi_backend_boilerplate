#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "${ROOT_DIR}"

STAGED_PY_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)"
if [[ -n "${STAGED_PY_FILES}" ]]; then
  printf '%s\n' "${STAGED_PY_FILES}" | xargs uv run ruff check
  printf '%s\n' "${STAGED_PY_FILES}" | xargs uv run ruff format --check
fi

./scripts/gitleaks-pre-commit.sh
