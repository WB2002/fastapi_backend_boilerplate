{
  "name": "fastapi-backend-boilerplate",
  "language": "python",
  "openapiUrl": "/openapi.json",
  "capabilities": {
    "health": {
      "method": "GET",
      "path": "/health/live"
    },
    "auth": {
      "register": {
        "method": "POST",
        "path": "/auth/register",
        "emailField": "email",
        "passwordField": "password"
      },
      "login": {
        "method": "POST",
        "path": "/auth/login",
        "emailField": "email",
        "passwordField": "password",
        "tokenPath": "accessToken",
        "refreshPath": "sessionId"
      },
      "me": {
        "method": "GET",
        "path": "/auth/me"
      },
      "refresh": {
        "method": "POST",
        "path": "/auth/refresh"
      }
    },
    "rbac": {
      "adminMethod": "GET",
      "adminPath": "/feature-flags"
    },
    "websockets": {
      "enabled": true,
      "path": "/socket.io/?EIO=4&transport=websocket"
    }
  },
  "architecture": {
    "publicRoutes": [
      "/",
      "/health",
      "/health/live",
      "/health/ready",
      "/auth/csrf",
      "/auth/register",
      "/auth/login",
      "/auth/refresh",
      "/example/captcha",
      "/example/jobs/echo",
      "/example/notification"
    ],
    "requireAuthOnNonPublic": true
  }
}